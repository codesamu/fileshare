[Unit]
Description=Home Drive file server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drive
Group=drive
WorkingDirectory=/opt/home-drive
EnvironmentFile=/opt/home-drive/.env
ExecStart=/usr/bin/node /opt/home-drive/server.js
Restart=always
RestartSec=3
# large files: no artificial limits on file descriptors
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
